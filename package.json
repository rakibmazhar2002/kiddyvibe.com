{
  "name": "atelier-commerce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply forme-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply forme-production --remote",
    "db:seed": "wrangler d1 execute forme-production --file=seed.sql --local",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.6.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "wrangler": "^3.99.0"
  }
}
